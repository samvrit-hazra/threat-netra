# AI Configuration
AI_PROVIDER=gemma
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-2-9b-it

# Fallback for testing only
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Website Owner / Admin Email (automatically assigned admin & approved)
OWNER_EMAIL=admin@threatnetra.com

# Demo Account Credentials (pre-configured instant login)
DEMO_EMAIL=demo@threatnetra.com
DEMO_PASSWORD=threatnetra-demo-2026

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/threatnetra

# Application
APP_ENV=development
SECRET_KEY=threatnetra-secret-session-key-change-in-production
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000
DEBUG=true

# Maps
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Background Tasks (optional)
REDIS_URL=redis://localhost:6379/0
